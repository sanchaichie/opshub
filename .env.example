# Copy to .env and fill in. Never commit .env. Every value below is read on the
# server through useRuntimeConfig(); only NUXT_PUBLIC_* values reach the browser.
#
# Local Supabase values come from `supabase status` after `pnpm db:start`.

# ── App ──────────────────────────────────────────────────────────────────────
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret for scheduler-called endpoints (Vercel Cron, pg_cron worker,
# GitHub Actions). Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Supabase (Phase 0) ───────────────────────────────────────────────────────
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
# Publishable (anon) key: safe for the browser, RLS applies.
NUXT_PUBLIC_SUPABASE_KEY=
# Secret (service role) key: bypasses RLS. Server only.
NUXT_SUPABASE_SECRET_KEY=

# ── Stripe, test mode only (Phase 1) ─────────────────────────────────────────
NUXT_STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the dashboard webhook endpoint in prod.
NUXT_STRIPE_WEBHOOK_SECRET=

# ── EasyPost, test mode (Phase 2) ────────────────────────────────────────────
NUXT_EASYPOST_API_KEY=
NUXT_EASYPOST_WEBHOOK_SECRET=

# ── OAuth state signing (Phase 3) ────────────────────────────────────────────
# Generate with: openssl rand -hex 32
NUXT_OAUTH_STATE_SECRET=

# ── Slack (Phase 3) ──────────────────────────────────────────────────────────
NUXT_SLACK_CLIENT_ID=
NUXT_SLACK_CLIENT_SECRET=

# ── HubSpot (Phase 4) ────────────────────────────────────────────────────────
NUXT_HUBSPOT_CLIENT_ID=
NUXT_HUBSPOT_CLIENT_SECRET=

# ── Google: Gmail + Calendar integration (Phase 5) ───────────────────────────
# A separate OAuth client from the one used for "Sign in with Google".
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=
# Comma-separated. In demo mode, email only ever goes to these addresses.
NUXT_DEMO_EMAIL_ALLOWLIST=

# ── Claude (Phase 6) ─────────────────────────────────────────────────────────
NUXT_ANTHROPIC_API_KEY=
NUXT_ANTHROPIC_MODEL=claude-haiku-5-5
NUXT_AI_DAILY_TOKEN_CAP=200000
