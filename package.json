    "h3": "^1.15.11",
    "nuxt": "^4.6.4",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
